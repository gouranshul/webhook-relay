# Copy to .env and replace every placeholder. Never commit .env.

# Base64-encoded 32-byte AES-256 key used to encrypt endpoint signing secrets at rest.
# Generate one with: openssl rand -base64 32
RELAY_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Bearer token required by the management API (Authorization: Bearer <token>).
RELAY_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN

POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD
